# =============================================================
# CineBook — backend/.env.example
# Copy this file to .env and fill in your own values
# NEVER commit .env to GitHub — it is in .gitignore
# =============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000

# ── MySQL Database (for the Node.js app) ─────────────────────
# These are your local MySQL Workbench credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=cinebook_db

# ── JWT Authentication ────────────────────────────────────────
# This is a secret string used to sign tokens — make it long and random
# Example: openssl rand -base64 32
JWT_SECRET=replace_this_with_a_long_random_secret_string_cinebook_2026

# JWT expiry — how long a login session lasts
JWT_EXPIRES_IN=7d

# ── Frontend URL (for CORS) ───────────────────────────────────
CLIENT_URL=http://localhost:5173

# Optional movie image fallback via TMDB
# Get a free key/token from https://developer.themoviedb.org/
TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=

# Ticket/payment confirmation email
# Leave EMAIL_ENABLED=false for development; the backend will print an email preview.
EMAIL_ENABLED=false
MAIL_FROM="CineBook <no-reply@cinebook.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_CONNECTION_TIMEOUT_MS=20000
SMTP_GREETING_TIMEOUT_MS=20000
SMTP_SOCKET_TIMEOUT_MS=30000
